# --- Flask ---
FLASK_ENV=production
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://docpulse:docpulse@localhost:5432/docpulse

# --- Azure Blob Storage ---
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=docpulse-documents

# --- Azure Key Vault (optional, for secret management in prod) ---
AZURE_KEY_VAULT_URL=

# --- Gemini API ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Hugging Face ---
HF_OCR_MODEL=microsoft/trocr-base-printed
HF_LAYOUT_MODEL=microsoft/layoutlmv3-base
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5500
